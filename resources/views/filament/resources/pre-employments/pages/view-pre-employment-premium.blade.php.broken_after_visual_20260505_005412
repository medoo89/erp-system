    $sfpeResolveFileType = function ($file): string {
        $path = strtolower((string) ($file['file_path'] ?? $file['path'] ?? $file['url'] ?? $file['name'] ?? ''));
        $title = strtolower((string) ($file['title'] ?? $file['name'] ?? ''));

        $source = trim($path . ' ' . $title);

        if (str_contains($source, '.pdf')) {
            return 'PDF';
        }

        if (str_contains($source, '.doc') || str_contains($source, '.docx')) {
            return 'DOC';
        }

        if (str_contains($source, '.xls') || str_contains($source, '.xlsx')) {
            return 'XLS';
        }

        if (
            str_contains($source, '.png') ||
            str_contains($source, '.jpg') ||
            str_contains($source, '.jpeg') ||
            str_contains($source, '.webp')
        ) {
            return 'IMG';
        }

        return 'FILE';
    };

    $sfpeResolveVersion = function ($file): string {
        $version = $file['version_no'] ?? $file['version'] ?? null;

        if (blank($version)) {
            return 'V1';
        }

        return 'V' . ltrim((string) $version, 'vV');
    };
