                if (str_contains($raw, 'medical') || str_contains($raw, 'health')) {
                    return ['icon' => 'health_and_safety', 'label' => 'Health'];
                }

                if (str_contains($raw, 'cert') || str_contains($raw, 'certificate')) {
                    return ['icon' => 'workspace_premium', 'label' => 'Certificate'];
                }

                if (str_contains($raw, 'photo') || str_contains($raw, 'personal_photo')) {
                    return ['icon' => 'account_circle', 'label' => 'Photo'];
                }

                if (str_contains($raw, 'cv') || str_contains($raw, 'resume')) {
                    return ['icon' => 'description', 'label' => 'CV'];
                }

                if (str_contains($raw, 'caf')) {
                    return ['icon' => 'assignment', 'label' => 'CAF'];
                }

                if (str_contains($raw, 'gl') || str_contains($raw, 'letter')) {
