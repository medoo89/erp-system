    /*
     * Safe file rows override:
     * - Shows files already stored in pre_employment_files.
     * - Shows candidate portal uploads from pre_employment_uploads.
     * - Signature badge appears ONLY for portal fields requested as download_sign_reupload.
     * - Does not guess signing by filename/category.
     */
    $sfpeFileRows = collect();

    try {
        $recordId = $record?->id;

        $signatureStatusByCategory = collect();

        if ($recordId && \Illuminate\Support\Facades\Schema::hasTable('pre_employment_portal_fields')) {
            $signatureFieldsQuery = \App\Models\PreEmploymentPortalField::query()
                ->where('pre_employment_id', $recordId)
                ->where('field_type', 'file');

            if (\Illuminate\Support\Facades\Schema::hasColumn('pre_employment_portal_fields', 'request_type')) {
                $signatureFieldsQuery->where('request_type', 'download_sign_reupload');
            } else {
                $signatureFieldsQuery->whereRaw('1 = 0');
            }

            $signatureFields = $signatureFieldsQuery->get();

            foreach ($signatureFields as $signatureField) {
                $signatureCategory = strtolower(trim((string) (
                    $signatureField->document_category
                    ?: $signatureField->field_key
                    ?: $signatureField->label
                )));

                if (filled($signatureCategory)) {
                    $signatureStatusByCategory->put(
                        $signatureCategory,
                        $signatureField->signature_status ?: 'waiting_for_candidate_to_sign'
                    );
                }
            }
        }

        $makeUrl = function (?string $path): ?string {
            if (! filled($path)) {
                return null;
            }

            return \Illuminate\Support\Facades\Storage::disk('public')->url($path);
        };

        $cleanLabel = function (?string $value): string {
            $value = trim((string) $value);

            if ($value === '') {
                return 'Other';
            }

            return ucwords(str_replace(['_', '-'], ' ', $value));
        };

        if ($recordId && \Illuminate\Support\Facades\Schema::hasTable('pre_employment_files')) {
            $storedFiles = \App\Models\PreEmploymentFile::query()
                ->where('pre_employment_id', $recordId)
                ->where(function ($query) {
                    $query->where('is_active', true)->orWhereNull('is_active');
                })
                ->orderByDesc('is_current')
                ->orderByDesc('created_at')
                ->orderByDesc('id')
                ->get();

            foreach ($storedFiles as $file) {
                $categoryKey = strtolower(trim((string) ($file->category ?: $file->title)));
                $signatureStatus = $signatureStatusByCategory->get($categoryKey);

                $sfpeFileRows->push([
                    'title' => $file->title ?: $cleanLabel($file->category),
                    'category' => $file->category ?: 'other',
                    'category_label' => $cleanLabel($file->category),
                    'source_label' => match ($file->uploaded_by_type) {
                        'candidate' => 'Candidate / Job Application',
                        'admin', 'erp', 'staff' => 'ERP Upload',
                        default => $cleanLabel($file->uploaded_by_type ?: 'File'),
                    },
                    'date_label' => optional($file->created_at)->format('M d, Y - H:i') ?: '—',
                    'is_current' => (bool) ($file->is_current ?? false),
                    'notes' => $file->notes,
                    'url' => $makeUrl($file->file_path),
                    'signature_status' => $signatureStatus,
                    'signature_label' => $signatureStatus
                        ? match ($signatureStatus) {
                            'signed' => 'Signed',
                            'completed' => 'Signed',
                            'uploaded_signed' => 'Signed',
                            default => 'Waiting for candidate to sign',
                        }
                        : null,
                    'signature_class' => in_array($signatureStatus, ['signed', 'completed', 'uploaded_signed'], true)
                        ? 'is-signed'
                        : ($signatureStatus ? 'is-waiting' : null),
                ]);
            }
        }

        if ($recordId && \Illuminate\Support\Facades\Schema::hasTable('pre_employment_uploads')) {
            $portalUploads = \App\Models\PreEmploymentUpload::query()
                ->where('pre_employment_id', $recordId)
                ->orderByDesc('created_at')
                ->orderByDesc('id')
                ->get();

            foreach ($portalUploads as $upload) {
                $categoryKey = strtolower(trim((string) ($upload->document_type ?: $upload->title)));
                $signatureStatus = $signatureStatusByCategory->get($categoryKey);

                $sfpeFileRows->push([
                    'title' => $upload->title ?: $upload->original_name ?: $cleanLabel($upload->document_type),
                    'category' => $upload->document_type ?: 'candidate_upload',
                    'category_label' => $cleanLabel($upload->document_type ?: 'Candidate Upload'),
                    'source_label' => $upload->uploaded_by_candidate ? 'Candidate Portal' : 'ERP Upload',
                    'date_label' => optional($upload->created_at)->format('M d, Y - H:i') ?: '—',
                    'is_current' => true,
                    'notes' => $upload->review_note,
                    'url' => $makeUrl($upload->file_path),
                    'signature_status' => $signatureStatus,
                    'signature_label' => $signatureStatus
                        ? match ($signatureStatus) {
                            'signed' => 'Signed',
                            'completed' => 'Signed',
                            'uploaded_signed' => 'Signed',
                            default => 'Waiting for candidate to sign',
                        }
                        : null,
                    'signature_class' => in_array($signatureStatus, ['signed', 'completed', 'uploaded_signed'], true)
                        ? 'is-signed'
                        : ($signatureStatus ? 'is-waiting' : null),
                ]);
            }
        }

        $sfpeFileRows = $sfpeFileRows
            ->unique(fn ($row) => ($row['title'] ?? '') . '|' . ($row['url'] ?? ''))
            ->values();
    } catch (\Throwable $e) {
        $sfpeFileRows = collect();
    }
