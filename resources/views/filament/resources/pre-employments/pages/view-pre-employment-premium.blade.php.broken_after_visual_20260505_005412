        @if($sfpeRows->isNotEmpty())
            <div class="sfpe-file-grid">
                @foreach($sfpeRows as $file)
                    @php
                        $iconData = $sfpeIconForFile($file);

                        $fileTitle = data_get($file, 'title')
                            ?: data_get($file, 'name')
                            ?: 'Document';

                        $fileCategory = data_get($file, 'category')
                            ?: data_get($file, 'document_type')
                            ?: 'Document';

                        $fileSource = data_get($file, 'source') ?: 'File';
                        $fileDate = data_get($file, 'date') ?: data_get($file, 'created_at') ?: '—';
                        $fileVersion = data_get($file, 'version_no') ?: data_get($file, 'version') ?: '1';
                        $fileIsCurrent = (bool) data_get($file, 'is_current', true);

                        $fileNotes = data_get($file, 'notes');
                        $fileUrl = data_get($file, 'url') ?: data_get($file, 'open_url') ?: data_get($file, 'download_url');

                        $signatureLabel = data_get($file, 'signature_label');
                        $signatureClass = data_get($file, 'signature_class') ?: 'is-waiting';

                        /*
                         * Direct signature badge lookup.
                         * Badge appears ONLY when a matching PreEmploymentPortalField
                         * has request_type = download_sign_upload/download_sign_reupload.
                         */
                        if (! filled($signatureLabel)) {
                            try {
                                $sfpeRecordForSignature = $record ?? $this->record ?? null;

                                if ($sfpeRecordForSignature) {
                                    $signatureField = \App\Models\PreEmploymentPortalField::query()
                                        ->where('pre_employment_id', $sfpeRecordForSignature->id)
                                        ->where('field_type', 'file')
                                        ->whereIn('request_type', ['download_sign_upload', 'download_sign_reupload'])
                                        ->where(function ($query) use ($fileTitle, $fileCategory) {
                                            $query->whereRaw('LOWER(label) = ?', [strtolower((string) $fileTitle)])
                                                ->orWhereRaw('LOWER(field_key) = ?', [strtolower((string) $fileTitle)]);

                                            if (strtolower((string) $fileCategory) !== 'other') {
                                                $query->orWhereRaw('LOWER(document_category) = ?', [strtolower((string) $fileCategory)]);
                                            }
                                        })
                                        ->latest('id')
                                        ->first();

                                    if ($signatureField) {
                                        $isSigned = filled($signatureField->signed_file_path)
                                            || filled($signatureField->signed_at)
                                            || ($signatureField->signature_status === 'signed');

                                        /*
                                         * If candidate already uploaded the matching signed file,
                                         * show Signed even if the portal field status was not updated before.
                                         */
                                        if (! $isSigned) {
                                            try {
                                                $matchedSignedFile = \App\Models\PreEmploymentFile::query()
                                                    ->where('pre_employment_id', $sfpeRecordForSignature->id)
                                                    ->where(function ($query) use ($signatureField, $fileTitle, $fileCategory) {
                                                        $query->whereRaw('LOWER(title) = ?', [strtolower((string) $signatureField->label)])
                                                            ->orWhereRaw('LOWER(title) = ?', [strtolower((string) $fileTitle)]);

                                                        if (strtolower((string) $fileCategory) !== 'other') {
                                                            $query->orWhereRaw('LOWER(category) = ?', [strtolower((string) $fileCategory)]);
                                                        }
                                                    })
                                                    ->where(function ($query) {
                                                        $query->where('uploaded_by_type', 'candidate')
                                                            ->orWhere('notes', 'like', '%public pre-employment portal%')
                                                            ->orWhere('notes', 'like', '%candidate%');
                                                    })
                                                    ->latest('id')
                                                    ->first();

                                                $isSigned = (bool) $matchedSignedFile;
                                            } catch (\Throwable $e) {
                                                $isSigned = false;
                                            }
                                        }

                                        $signatureLabel = $isSigned ? 'Signed' : 'Waiting for candidate to sign';
                                        $signatureClass = $isSigned ? 'is-signed' : 'is-waiting';
                                    }
                                }
                            } catch (\Throwable $e) {
                                // Keep file card visible even if signature lookup fails.
                            }
                        }
