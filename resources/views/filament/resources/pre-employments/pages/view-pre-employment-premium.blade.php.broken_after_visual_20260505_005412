                $response = [];

                if (filled($rowArray['candidate_response'] ?? null)) {
                    $decoded = json_decode((string) $rowArray['candidate_response'], true);
                    if (is_array($decoded)) {
                        $response = $decoded;
                    }
                }

                $thread = collect($response['thread'] ?? [])
                    ->filter(fn ($item) => is_array($item))
                    ->values();

                $uploadedFiles = collect($response['uploaded_files'] ?? [])
                    ->filter(fn ($item) => is_array($item))
                    ->values();

                $candidateRequestCards->push([
                    'title' => $sfpeClean($rowArray['title'] ?? 'Candidate Request'),
                    'type' => $sfpeClean($rowArray['type'] ?? null),
                    'status' => $sfpeClean($rowArray['request_status'] ?? null),
                    'proposed_salary' => $sfpeMoney($rowArray['proposed_salary'] ?? null, $rowArray['currency'] ?? null),
                    'accepted_salary' => $sfpeMoney($rowArray['accepted_salary'] ?? null, $rowArray['accepted_currency'] ?? null),
                    'decision' => $sfpeClean($response['decision'] ?? null),
                    'counter_offer' => $sfpeMoney($response['counter_offer'] ?? ($rowArray['candidate_counter_offer'] ?? null), $rowArray['currency'] ?? null),
                    'negotiation_result' => $sfpeClean($rowArray['negotiation_result'] ?? null),
                    'requires_upload' => (bool) ($rowArray['requires_upload'] ?? false),
                    'requested_file_label' => $sfpeClean($rowArray['requested_file_label'] ?? null),
                    'created_at' => filled($rowArray['created_at'] ?? null) ? \Carbon\Carbon::parse($rowArray['created_at'])->format('M d, Y - H:i') : '—',
                    'updated_at' => filled($rowArray['updated_at'] ?? null) ? \Carbon\Carbon::parse($rowArray['updated_at'])->format('M d, Y - H:i') : '—',
                    'responded_at' => filled($rowArray['responded_at'] ?? null) ? \Carbon\Carbon::parse($rowArray['responded_at'])->format('M d, Y - H:i') : '—',
                    'thread' => $thread,
                    'uploaded_files' => $uploadedFiles,
                ]);
            }
        }
    } catch (\Throwable $e) {
        $candidateRequestCards = collect();
    }

