    $record = $this->record ?? $record ?? null;

    $sfpeClean = $sfpeClean ?? function ($value) {
        if ($value instanceof \Carbon\CarbonInterface) {
            return $value->format('M d, Y - H:i');
        }

        if (is_bool($value)) {
            return $value ? 'Yes' : 'No';
        }

        if ($value === null || $value === '') {
            return '—';
        }

        if (is_array($value)) {
            $value = collect($value)
                ->flatten()
                ->filter(fn ($item) => filled($item))
                ->map(fn ($item) => is_scalar($item) ? (string) $item : json_encode($item, JSON_UNESCAPED_UNICODE))
                ->implode(', ');
        }

        $textValue = trim((string) $value);
        $map = [
            'yes' => 'Yes',
            'y_e_s' => 'Yes',
            'no' => 'No',
            'n_o' => 'No',
            'true' => 'Yes',
            'false' => 'No',
            '1' => 'Yes',
            '0' => 'No',
        ];

        $key = strtolower($textValue);

        if (array_key_exists($key, $map)) {
            return $map[$key];
        }

        return trim(preg_replace('/\s+/', ' ', str_replace('_', ' ', $textValue))) ?: '—';
    };

    $sfpeMoney = function ($amount, $currency = null) use ($sfpeClean) {
        if ($amount === null || $amount === '') {
            return '—';
        }

        $number = is_numeric($amount) ? number_format((float) $amount, 2) : $sfpeClean($amount);

        return trim($number . ' ' . ($currency ?: ''));
    };

    $sfpeStatusLabel = $sfpeClean($record?->status ?? null);
    $sfpeIsReadyForEmployment = ($record?->status ?? null) === 'ready_for_employment';

    $preEmploymentEditUrl = '#';
    $jobApplicationUrl = '#';
    $portalUrl = '#';

    try {
        if ($record) {
            $preEmploymentEditUrl = \App\Filament\Resources\PreEmployments\PreEmploymentResource::getUrl('edit', ['record' => $record]);
        }
    } catch (\Throwable $e) {
        $preEmploymentEditUrl = url('/admin/pre-employments/' . ($record?->id ?? '') . '/edit');
    }

    try {
        if ($record?->job_application_id) {
            $jobApplicationUrl = \App\Filament\Resources\JobApplications\JobApplicationResource::getUrl('view', ['record' => $record->job_application_id]);
        } else {
            $jobApplicationUrl = url('/admin/job-applications');
        }
    } catch (\Throwable $e) {
        $jobApplicationUrl = url('/admin/job-applications/' . ($record?->job_application_id ?? ''));
    }

    try {
        if (filled($record?->portal_token)) {
            $portalUrl = url('/pre-employment-portal/' . $record->portal_token);
        }
    } catch (\Throwable $e) {
        $portalUrl = '#';
    }

    $sfpeClientName = $record?->job?->project?->client?->name ?? '—';
    $sfpeProjectName = $record?->job?->project?->name ?? '—';
    $sfpePositionName = $record?->job?->title ?? '—';

    $candidateRequestCards = collect();

    try {
        if (\Illuminate\Support\Facades\Schema::hasTable('candidate_requests')) {
            $rows = \Illuminate\Support\Facades\DB::table('candidate_requests')
                ->where('job_application_id', $record?->job_application_id)
                ->orderBy('created_at')
                ->get();

            foreach ($rows as $row) {
                $rowArray = (array) $row;
                $response = [];

                if (filled($rowArray['candidate_response'] ?? null)) {
                    $decoded = json_decode((string) $rowArray['candidate_response'], true);
                    if (is_array($decoded)) {
                        $response = $decoded;
                    }
                }

                $thread = collect($response['thread'] ?? [])
                    ->filter(fn ($item) => is_array($item))
                    ->values();

                $uploadedFiles = collect($response['uploaded_files'] ?? [])
                    ->filter(fn ($item) => is_array($item))
                    ->values();

                $candidateRequestCards->push([
                    'title' => $sfpeClean($rowArray['title'] ?? 'Candidate Request'),
                    'type' => $sfpeClean($rowArray['type'] ?? null),
                    'status' => $sfpeClean($rowArray['request_status'] ?? null),
                    'proposed_salary' => $sfpeMoney($rowArray['proposed_salary'] ?? null, $rowArray['currency'] ?? null),
                    'accepted_salary' => $sfpeMoney($rowArray['accepted_salary'] ?? null, $rowArray['accepted_currency'] ?? null),
                    'decision' => $sfpeClean($response['decision'] ?? null),
                    'counter_offer' => $sfpeMoney($response['counter_offer'] ?? ($rowArray['candidate_counter_offer'] ?? null), $rowArray['currency'] ?? null),
                    'negotiation_result' => $sfpeClean($rowArray['negotiation_result'] ?? null),
                    'requires_upload' => (bool) ($rowArray['requires_upload'] ?? false),
                    'requested_file_label' => $sfpeClean($rowArray['requested_file_label'] ?? null),
                    'created_at' => filled($rowArray['created_at'] ?? null) ? \Carbon\Carbon::parse($rowArray['created_at'])->format('M d, Y - H:i') : '—',
                    'updated_at' => filled($rowArray['updated_at'] ?? null) ? \Carbon\Carbon::parse($rowArray['updated_at'])->format('M d, Y - H:i') : '—',
                    'responded_at' => filled($rowArray['responded_at'] ?? null) ? \Carbon\Carbon::parse($rowArray['responded_at'])->format('M d, Y - H:i') : '—',
                    'thread' => $thread,
                    'uploaded_files' => $uploadedFiles,
                ]);
            }
        }
    } catch (\Throwable $e) {
        $candidateRequestCards = collect();
    }

    $sfpeExpenses = collect();

    try {
        $sfpeExpenses = $record?->financeExpenses?->values() ?? collect();
