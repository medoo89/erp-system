    $record = $record ?? $this->record ?? null;

    $job = $record?->job ?? $record?->jobOpening ?? null;
    $project = $record?->project ?? $job?->project ?? null;
    $client = $record?->client ?? $project?->client ?? $job?->client ?? null;

    $answersRaw = $record?->answers ?? $record?->application_answers ?? $record?->form_answers ?? [];
    if (is_string($answersRaw)) {
        $decodedAnswers = json_decode($answersRaw, true);
        $answersRaw = is_array($decodedAnswers) ? $decodedAnswers : [];
    }
    if (! is_array($answersRaw)) {
        $answersRaw = [];
    }

    $normalizeValue = function ($value) {
        if (is_array($value)) {
            return collect($value)
                ->flatten()
                ->filter(fn ($item) => filled($item))
                ->implode(', ');
        }

        if (is_bool($value)) {
            return $value ? 'Yes' : 'No';
        }

        $value = trim((string) ($value ?? ''));

        if ($value === '') {
            return '-';
        }

        $lower = strtolower($value);

        return match ($lower) {
            'n_o', 'no_', 'n-o', 'no' => 'No',
            'y_es', 'yes_', 'y-es', 'yes' => 'Yes',
            default => str_replace('_', ' ', $value),
        };
    };

    $answerFind = function (array $keys) use ($answersRaw, $normalizeValue) {
        foreach ($keys as $key) {
            foreach ($answersRaw as $answerKey => $answerValue) {
                $cleanKey = strtolower(str_replace([' ', '-', '_'], '', (string) $answerKey));
                $cleanWanted = strtolower(str_replace([' ', '-', '_'], '', (string) $key));

                if ($cleanKey === $cleanWanted || str_contains($cleanKey, $cleanWanted) || str_contains($cleanWanted, $cleanKey)) {
                    return $normalizeValue($answerValue);
                }
            }
        }

        return null;
    };

    $countryCode = $record?->phone_country_code
        ?? $record?->country_code
        ?? $answerFind(['phone country code', 'country code'])
        ?? '';

    $cleanPhone = function ($value) use ($countryCode) {
        $value = trim((string) ($value ?? ''));

        if ($value === '' || $value === '-') {
            return '-';
        }

        if (str_starts_with($value, '+')) {
            return $value;
        }

        $code = trim((string) $countryCode);

        if ($code !== '' && $code !== '-' && ! str_starts_with($value, '+')) {
            $code = str_starts_with($code, '+') ? $code : '+' . ltrim($code, '+');
            return $code . ltrim($value, '0');
        }

        return $value;
    };

    $fullName = $record?->full_name
        ?? $record?->candidate_name
        ?? $record?->name
        ?? $answerFind(['full name', 'name', 'applicant name'])
        ?? '-';

    $email = $record?->email
        ?? $record?->email_address
        ?? $answerFind(['email address', 'email'])
        ?? '-';

    $phone = $cleanPhone(
        $record?->phone_number
        ?? $record?->phone
        ?? $answerFind(['phone number', 'phone'])
