<script id="sf-force-candidate-request-colored-decisions-v3-js">
(function () {
    function normalize(text) {
        return String(text || '').replace(/\s+/g, ' ').trim().toLowerCase();
    }

    function forceDecisionColors() {
        const candidates = Array.from(document.querySelectorAll('label, button, a, div, span'))
            .filter(function (el) {
                const text = normalize(el.innerText || el.textContent);
                if (!['approve', 'decline', 'reconsider'].includes(text)) return false;

                const box = el.getBoundingClientRect();
                if (box.width < 80 || box.height < 25) return false;

                return true;
            });

        candidates.forEach(function (el) {
            const text = normalize(el.innerText || el.textContent);

            el.classList.add('sf-force-decision-button');

            if (text === 'approve') {
                el.classList.add('sf-force-decision-approve');
                el.style.setProperty('background', 'linear-gradient(135deg, #ecfdf5 0%, #bbf7d0 100%)', 'important');
                el.style.setProperty('border-color', 'rgba(34,197,94,.65)', 'important');
                el.style.setProperty('color', '#047857', 'important');
                el.style.setProperty('box-shadow', '0 16px 34px rgba(34,197,94,.16)', 'important');
            }

            if (text === 'decline') {
                el.classList.add('sf-force-decision-decline');
                el.style.setProperty('background', 'linear-gradient(135deg, #fef2f2 0%, #fecaca 100%)', 'important');
                el.style.setProperty('border-color', 'rgba(239,68,68,.62)', 'important');
                el.style.setProperty('color', '#b91c1c', 'important');
                el.style.setProperty('box-shadow', '0 16px 34px rgba(239,68,68,.15)', 'important');
            }

            if (text === 'reconsider') {
                el.classList.add('sf-force-decision-reconsider');
                el.style.setProperty('background', 'linear-gradient(135deg, #fff7ed 0%, #fed7aa 100%)', 'important');
                el.style.setProperty('border-color', 'rgba(249,115,22,.62)', 'important');
                el.style.setProperty('color', '#c2410c', 'important');
                el.style.setProperty('box-shadow', '0 16px 34px rgba(249,115,22,.15)', 'important');
            }

            el.style.setProperty('border-radius', '20px', 'important');
            el.style.setProperty('font-weight', '950', 'important');
            el.style.setProperty('min-height', '58px', 'important');
        });
    }

    document.addEventListener('DOMContentLoaded', forceDecisionColors);
    window.addEventListener('load', forceDecisionColors);

    setTimeout(forceDecisionColors, 50);
    setTimeout(forceDecisionColors, 300);
    setTimeout(forceDecisionColors, 900);
    setTimeout(forceDecisionColors, 1800);

    new MutationObserver(forceDecisionColors).observe(document.documentElement, {
        childList: true,
        subtree: true,
        attributes: true,
    });
})();
</script>

