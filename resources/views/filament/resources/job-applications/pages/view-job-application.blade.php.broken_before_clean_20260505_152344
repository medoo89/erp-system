@php
    $application = $record ?? $this->record ?? null;

    $candidateName = data_get($application, 'full_name')
        ?? data_get($application, 'candidate_name')
        ?? data_get($application, 'name')
        ?? '-';

    $position = data_get($application, 'position')
        ?? data_get($application, 'job.title')
        ?? data_get($application, 'job.position')
        ?? data_get($application, 'jobOpening.title')
        ?? '-';

    $project = data_get($application, 'project.name')
        ?? data_get($application, 'job.project.name')
        ?? data_get($application, 'jobOpening.project.name')
        ?? data_get($application, 'project_name')
        ?? '-';

    $client = data_get($application, 'client.name')
        ?? data_get($application, 'job.client.name')
        ?? data_get($application, 'job.project.client.name')
        ?? data_get($application, 'jobOpening.project.client.name')
        ?? data_get($application, 'client_name')
        ?? '-';

    $statusRaw = data_get($application, 'status') ?? '-';
    $status = $statusRaw !== '-' ? ucwords(str_replace('_', ' ', (string) $statusRaw)) : '-';

    $workflowRaw = data_get($application, 'request_workflow_status')
        ?? data_get($application, 'workflow_status')
        ?? data_get($application, 'request_status')
        ?? '-';

    $workflow = $workflowRaw !== '-' ? ucwords(str_replace('_', ' ', (string) $workflowRaw)) : '-';

    $appliedAtRaw = data_get($application, 'applied_at') ?? data_get($application, 'created_at');
    $appliedAt = $appliedAtRaw ? \Illuminate\Support\Carbon::parse($appliedAtRaw)->format('M d, Y H:i') : '-';

    $updatedAtRaw = data_get($application, 'updated_at');
    $updatedAt = $updatedAtRaw ? \Illuminate\Support\Carbon::parse($updatedAtRaw)->format('M d, Y H:i') : '-';

    $email = data_get($application, 'email')
        ?? data_get($application, 'candidate_email')
        ?? data_get($application, 'applicant_email')
        ?? '-';

    $phone = data_get($application, 'phone')
        ?? data_get($application, 'phone_number')
        ?? data_get($application, 'candidate_phone')
        ?? data_get($application, 'mobile')
        ?? '-';

    $nationality = data_get($application, 'nationality') ?? '-';

    $yearsExperience = data_get($application, 'years_of_experience')
        ?? data_get($application, 'experience_years')
        ?? data_get($application, 'years_experience')
        ?? '-';

    $expectedSalary = data_get($application, 'expected_salary')
        ?? data_get($application, 'salary_expectation')
        ?? data_get($application, 'requested_salary')
        ?? '-';

    $currentSalary = data_get($application, 'current_salary') ?? '-';

    $noticePeriod = data_get($application, 'notice_period') ?? '-';

    $source = data_get($application, 'source')
        ?? data_get($application, 'application_source')
        ?? '-';

    $notes = data_get($application, 'notes')
        ?? data_get($application, 'remarks')
        ?? data_get($application, 'comment')
        ?? data_get($application, 'internal_notes')
        ?? null;

    $rawAttributes = $application && method_exists($application, 'getAttributes')
        ? collect($application->getAttributes())
        : collect([]);

    $hiddenKeys = [
        'id',
        'created_at',
        'updated_at',
        'deleted_at',
        'full_name',
        'candidate_name',
        'name',
        'position',
        'project_name',
        'client_name',
        'status',
        'request_workflow_status',
        'workflow_status',
        'request_status',
        'applied_at',
        'email',
        'candidate_email',
        'applicant_email',
        'phone',
        'phone_number',
        'candidate_phone',
        'mobile',
        'nationality',
        'years_of_experience',
        'experience_years',
        'years_experience',
        'expected_salary',
        'salary_expectation',
        'requested_salary',
        'current_salary',
        'notice_period',
        'source',
        'application_source',
        'notes',
        'remarks',
        'comment',
        'internal_notes',
    ];

    $extraAttributes = $rawAttributes
        ->reject(fn ($value, $key) => in_array($key, $hiddenKeys, true))
        ->reject(fn ($value) => blank($value))
        ->mapWithKeys(function ($value, $key) {
            $label = ucwords(str_replace('_', ' ', (string) $key));

            if (is_bool($value)) {
                $value = $value ? 'Yes' : 'No';
            } elseif (is_array($value) || is_object($value)) {
                $value = json_encode($value, JSON_UNESCAPED_UNICODE | JSON_PRETTY_PRINT);
            }

            return [$label => $value];
        });
