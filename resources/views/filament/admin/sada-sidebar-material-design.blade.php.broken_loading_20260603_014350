<style id="sf-sada-clean-sidebar-style-v1">
/*
|--------------------------------------------------------------------------
| Sada Fezzan ERP - Clean Premium Sidebar
|--------------------------------------------------------------------------
| This is visual-only CSS for the Filament admin sidebar.
| It does not change routes, permissions, resources, or navigation logic.
| Target project: Sada Fezzan ERP only.
*/

:root {
    --sf-sidebar-bg: rgba(255,255,255,.98);
    --sf-sidebar-text: #465365;
    --sf-sidebar-muted: #94a3b8;
    --sf-sidebar-blue: #2563eb;
    --sf-sidebar-cyan: #22d3ee;
    --sf-sidebar-teal: #0f766e;
    --sf-sidebar-active: linear-gradient(135deg, #0f766e 0%, #2563eb 100%);
    --sf-sidebar-active-icon: linear-gradient(135deg, #5eead4 0%, #14b8a6 52%, #2563eb 100%);
    --sf-sidebar-border: rgba(148,163,184,.16);
    --sf-sidebar-shadow: 0 28px 80px rgba(15,23,42,.08);
}

/* Sidebar container */
.fi-sidebar {
    background:
        radial-gradient(circle at top left, rgba(34,211,238,.10), transparent 34%),
        linear-gradient(180deg, rgba(255,255,255,.99), rgba(248,252,253,.98)) !important;
    border-right: 1px solid rgba(148,163,184,.14) !important;
    box-shadow: 22px 0 70px rgba(15,23,42,.045) !important;
}

.dark .fi-sidebar {
    background:
        radial-gradient(circle at top left, rgba(34,211,238,.12), transparent 34%),
        linear-gradient(180deg, rgba(15,23,42,.98), rgba(2,6,23,.96)) !important;
    border-right-color: rgba(148,163,184,.12) !important;
}

/* Sidebar scroll/body spacing */
.fi-sidebar-nav {
    padding: 20px 12px 92px !important;
    gap: 8px !important;
}

/* Logo / brand area */
.fi-sidebar-header {
    min-height: 92px !important;
    padding: 18px 18px 14px !important;
    border-bottom: 1px solid rgba(148,163,184,.12) !important;
    margin-bottom: 14px !important;
}

.fi-sidebar-header img,
.fi-logo {
    max-height: 64px !important;
    object-fit: contain !important;
}

/* Main nav item shape */
.fi-sidebar-item {
    margin: 8px 0 !important;
}

.fi-sidebar-item a,
.fi-sidebar-item button,
.fi-sidebar-item > .fi-sidebar-item-button {
    min-height: 62px !important;
    border-radius: 28px !important;
    padding: 10px 16px !important;
    gap: 18px !important;
    color: var(--sf-sidebar-text) !important;
    font-weight: 950 !important;
    font-size: 16px !important;
    letter-spacing: -.01em !important;
    transition: transform .18s ease, background .18s ease, box-shadow .18s ease, color .18s ease !important;
    background: transparent !important;
    border: 1px solid transparent !important;
}

.fi-sidebar-item a:hover,
.fi-sidebar-item button:hover,
.fi-sidebar-item > .fi-sidebar-item-button:hover {
    background: rgba(15,118,110,.055) !important;
    transform: translateX(2px);
}

/* Icon box for all items */
.fi-sidebar-item-icon,
.fi-sidebar-item svg,
.fi-sidebar-item .material-symbols-rounded,
.fi-sidebar-item [class*="material-symbols"] {
    width: 54px !important;
    min-width: 54px !important;
    height: 54px !important;
    border-radius: 20px !important;
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
    background: rgba(255,255,255,.72) !important;
    border: 1px solid rgba(148,163,184,.18) !important;
    box-shadow: 0 14px 34px rgba(15,23,42,.045) !important;
    color: #475569 !important;
    padding: 13px !important;
}

/* Fix heroicon svg internal size */
.fi-sidebar-item svg {
    padding: 14px !important;
}

/* Label */
.fi-sidebar-item-label {
    color: inherit !important;
    font-size: 16px !important;
    font-weight: 950 !important;
    line-height: 1.15 !important;
}

/* Active item: long blue gradient pill like the reference */
.fi-sidebar-item.fi-active a,
.fi-sidebar-item.fi-active button,
.fi-sidebar-item.fi-active > .fi-sidebar-item-button,
.fi-sidebar-item-active a,
.fi-sidebar-item-active button {
    min-height: 76px !important;
    border-radius: 34px !important;
    background: var(--sf-sidebar-active) !important;
    color: #ffffff !important;
    box-shadow: 0 22px 54px rgba(37,99,235,.24) !important;
    border-color: rgba(255,255,255,.12) !important;
}

.fi-sidebar-item.fi-active a:hover,
.fi-sidebar-item.fi-active button:hover,
.fi-sidebar-item-active a:hover,
.fi-sidebar-item-active button:hover {
    transform: translateX(0) !important;
}

/* Active icon */
.fi-sidebar-item.fi-active .fi-sidebar-item-icon,
.fi-sidebar-item.fi-active svg,
.fi-sidebar-item.fi-active .material-symbols-rounded,
.fi-sidebar-item.fi-active [class*="material-symbols"],
.fi-sidebar-item-active .fi-sidebar-item-icon,
.fi-sidebar-item-active svg {
    background: var(--sf-sidebar-active-icon) !important;
    color: #06202b !important;
    border-color: rgba(255,255,255,.20) !important;
    box-shadow:
        inset 0 0 0 1px rgba(255,255,255,.20),
        0 18px 36px rgba(20,184,166,.26) !important;
}

/* Group labels: section divider with dot */
.fi-sidebar-group {
    margin-top: 22px !important;
    padding-top: 18px !important;
    border-top: 1px solid rgba(148,163,184,.16) !important;
}

.fi-sidebar-group-label {
    position: relative !important;
    margin: 0 8px 12px !important;
    padding-left: 32px !important;
    color: #a16207 !important;
    font-size: 13px !important;
    line-height: 1 !important;
    letter-spacing: .12em !important;
    font-weight: 1000 !important;
    text-transform: uppercase !important;
}

.fi-sidebar-group-label::before {
    content: "";
    position: absolute;
    left: 4px;
    top: 50%;
    width: 14px;
    height: 14px;
    border-radius: 999px;
    transform: translateY(-50%);
    background: linear-gradient(135deg, #22d3ee, #2563eb);
    box-shadow: 0 0 0 10px rgba(34,211,238,.10);
}

/* Group collapse icon */
.fi-sidebar-group-collapse-button {
    color: #94a3b8 !important;
}

/* Badge/counts */
.fi-sidebar-item-badge {
    border-radius: 999px !important;
    padding: 5px 9px !important;
    background: rgba(34,211,238,.13) !important;
    color: #0f766e !important;
    font-weight: 950 !important;
}

/* Collapsed sidebar */
.fi-sidebar.fi-sidebar-collapsed .fi-sidebar-nav {
    padding-inline: 9px !important;
}

.fi-sidebar.fi-sidebar-collapsed .fi-sidebar-item a,
.fi-sidebar.fi-sidebar-collapsed .fi-sidebar-item button,
.fi-sidebar.fi-sidebar-collapsed .fi-sidebar-item > .fi-sidebar-item-button {
    justify-content: center !important;
    padding-inline: 8px !important;
}

.fi-sidebar.fi-sidebar-collapsed .fi-sidebar-item-label,
.fi-sidebar.fi-sidebar-collapsed .fi-sidebar-group-label {
    display: none !important;
}

.fi-sidebar.fi-sidebar-collapsed .fi-sidebar-item-icon,
.fi-sidebar.fi-sidebar-collapsed .fi-sidebar-item svg {
    margin: 0 !important;
}

/* Dark mode */
.dark .fi-sidebar-item a,
.dark .fi-sidebar-item button,
.dark .fi-sidebar-item > .fi-sidebar-item-button {
    color: #cbd5e1 !important;
}

.dark .fi-sidebar-item-icon,
.dark .fi-sidebar-item svg,
.dark .fi-sidebar-item .material-symbols-rounded,
.dark .fi-sidebar-item [class*="material-symbols"] {
    background: rgba(15,23,42,.76) !important;
    border-color: rgba(148,163,184,.16) !important;
    color: #cbd5e1 !important;
}

.dark .fi-sidebar-item a:hover,
.dark .fi-sidebar-item button:hover,
.dark .fi-sidebar-item > .fi-sidebar-item-button:hover {
    background: rgba(34,211,238,.08) !important;
}

.dark .fi-sidebar-group {
    border-top-color: rgba(148,163,184,.13) !important;
}

.dark .fi-sidebar-group-label {
    color: #60a5fa !important;
}

/* Mobile */
@media (max-width: 1024px) {
    .fi-sidebar-nav {
        padding-bottom: 32px !important;
    }

    .fi-sidebar-item a,
    .fi-sidebar-item button,
    .fi-sidebar-item > .fi-sidebar-item-button {
        min-height: 58px !important;
        border-radius: 24px !important;
    }

    .fi-sidebar-item.fi-active a,
    .fi-sidebar-item.fi-active button,
    .fi-sidebar-item-active a,
    .fi-sidebar-item-active button {
        min-height: 66px !important;
        border-radius: 28px !important;
    }

    .fi-sidebar-item-icon,
    .fi-sidebar-item svg {
        width: 48px !important;
        min-width: 48px !important;
        height: 48px !important;
        border-radius: 18px !important;
    }
}
</style>

<script>
document.addEventListener('DOMContentLoaded', function () {
    /*
     | Visual helper only:
     | adds a stable class to current/active sidebar items across Filament versions.
     */
    const markActiveSidebarItems = () => {
        document.querySelectorAll('.fi-sidebar-item').forEach((item) => {
            const link = item.querySelector('a[href]');
            if (!link) return;

            try {
                const itemUrl = new URL(link.href, window.location.origin);
                const current = window.location.pathname.replace(/\/+$/, '');
                const target = itemUrl.pathname.replace(/\/+$/, '');

                if (target && current === target) {
                    item.classList.add('fi-active');
                }
            } catch (e) {}
        });
    };

    markActiveSidebarItems();

    const sidebar = document.querySelector('.fi-sidebar');
    if (sidebar) {
        new MutationObserver(markActiveSidebarItems).observe(sidebar, {
            childList: true,
            subtree: true,
            attributes: true,
        });
    }
});
</script>
